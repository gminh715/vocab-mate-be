# Server configuration
PORT=3000
HOST=0.0.0.0
ENVIRONMENT=development

# Database configuration (PostgreSQL)
# Format for asyncpg: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vocab_mate
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/vocab_mate

# Authentication
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret-32-chars
JWT_REFRESH_EXPIRES_IN=604800
BCRYPT_ROUNDS=12

# CORS & Cookies
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://vocabmate.onrender.com
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Timezone settings
ANALYTICS_TIMEZONE=Asia/Ho_Chi_Minh

# AI Providers
GEMINI_API_KEY=replace-with-a-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=replace-with-a-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
AI_REQUEST_TIMEOUT_MS=30000

# Guardian Content API
GUARDIAN_API_KEY=replace-with-a-guardian-api-key

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace-with-your-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-your-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-your-cloudinary-api-secret
CLOUDINARY_FOLDER=vocab-mate/avatars
